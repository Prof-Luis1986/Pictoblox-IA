    "test:sources": "node scripts/audit-sources.mjs",
    "test:sb3": "node scripts/audit-sb3.mjs",
    "test:privacy": "node scripts/audit-privacy.mjs",
    "test:progress-wall": "node scripts/audit-progress-wall.mjs",
    "test:evidence": "node scripts/audit-evidence.mjs",
    "test:delivery": "node --import tsx scripts/audit-delivery.ts",
    "test:receipt-pdf": "node --import tsx scripts/audit-receipt-pdf.ts",
    "test:modal-hooks": "node --import tsx scripts/audit-modal-hooks.tsx",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
